{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bun \"${CURSOR_PLUGIN_ROOT}/scripts/cursor-correctionguy-hook.ts\" sessionStart"
      }
    ],
    "preToolUse": [
      {
        "command": "bun \"${CURSOR_PLUGIN_ROOT}/scripts/cursor-correctionguy-hook.ts\" preToolUse",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": "bun \"${CURSOR_PLUGIN_ROOT}/scripts/cursor-correctionguy-hook.ts\" postToolUse",
        "timeout": 180
      }
    ],
    "stop": [
      {
        "command": "bun \"${CURSOR_PLUGIN_ROOT}/scripts/cursor-correctionguy-hook.ts\" stop",
        "timeout": 180
      }
    ]
  }
}
