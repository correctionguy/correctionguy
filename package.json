{
  "name": "correctionguy",
  "version": "3.26.0",
  "description": "Agents often drift and waste time on the wrong work. Correction Guy watches from the sidelines and steers them back on track.",
  "keywords": [
    "codex",
    "discipline",
    "pi-package",
    "review",
    "workflow"
  ],
  "type": "module",
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "test": "for f in scripts/*.test.ts; do bun test \"$f\" || exit 1; done",
    "typecheck": "tsc",
    "validate": "bun scripts/validate.ts"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.155.1",
    "es-toolkit": "1.52.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@types/bun": "latest",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-plugin-eslint": "^1.83.0",
    "typescript": "^7.0.2",
    "ultracite": "7.12.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./scripts/pi-extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
